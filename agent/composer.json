{
    "name": "cdpasto/nexus-agent",
    "description": "Agente de monitoreo y auditoría para el panel Nexus de CD Pasto",
    "type": "library",
    "version": "1.1.1",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Cdpasto\\NexusAgent\\": "src/"
        }
    },
    "extra": {
